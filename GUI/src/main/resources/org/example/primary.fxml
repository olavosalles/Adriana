<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="550.0" prefWidth="700.0" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.PrimaryController">
   <children>
      <Label text="Meus Exercicios" />
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="Multiplo">
            <content>
              <VBox spacing="10.0">
                     <children>
                        <Label text="Exercicio do Multiplo" />
                        <Label text="Numero 1:" />
                        <TextField fx:id="txtBase" />
                        <Label text="Numero 2:" />
                        <TextField fx:id="txtMultiplo" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onVerificarMultiplo" text="Verificar" />
                              <Button mnemonicParsing="false" onAction="#onLimparMultiplo" text="Limpar" />
                           </children>
                        </HBox>
                        <Label fx:id="lblMultiploResultado" text="Resultado..." />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
            </content>
          </Tab>
          <Tab text="Login">
            <content>
              <VBox spacing="10.0">
                     <children>
                        <Label text="Exercicio de Login" />
                        <Label text="Usuario:" />
                        <TextField fx:id="txtLoginUsuario" />
                        <Label text="Senha:" />
                        <PasswordField fx:id="txtLoginSenha" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onTentarLogin" text="Entrar" />
                              <Button mnemonicParsing="false" onAction="#onLimparLogin" text="Limpar" />
                           </children>
                        </HBox>
                        <Label fx:id="lblLoginResultado" text="Resultado..." />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
            </content>
          </Tab>
            <Tab text="Compras">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Exercicio de Compras" />
                        <Label text="Escolha o produto:" />
                        <ComboBox fx:id="cbProdutos" prefWidth="300.0" />
                        <Label text="Quantidade:" />
                        <TextField fx:id="txtQtdCompra" prefWidth="100.0" text="1" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onAdicionarAoCarrinho" text="Adicionar" />
                              <Button mnemonicParsing="false" onAction="#onLimparCarrinho" text="Limpar Tudo" />
                           </children>
                        </HBox>
                        <Label text="Itens comprados:" />
                        <TextArea fx:id="txtCarrinho" editable="false" prefHeight="150.0" VBox.vgrow="ALWAYS" />
                        <Label fx:id="lblTotalCompra" text="Total: R$ 0,00" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Temperatura">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Exercicio da Temperatura" />
                        <Label text="Digite a temperatura:" />
                        <TextField fx:id="txtTemperatura" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onAdicionarTemperatura" text="Adicionar" />
                              <Button mnemonicParsing="false" onAction="#onLimparTemperaturas" text="Limpar" />
                           </children>
                        </HBox>
                        <TextArea fx:id="txtListaTemperatura" editable="false" prefHeight="150.0" VBox.vgrow="ALWAYS" />
                        <Label fx:id="lblResumoTemperatura" text="Media..." />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="35 Camelos">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Exercicio dos 35 Camelos" />
                        <Button mnemonicParsing="false" onAction="#onCalcularCamelos" text="Calcular divisao" />
                        <TextArea fx:id="txtCamelosResultado" editable="false" prefHeight="250.0" VBox.vgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Viagem">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Calculadora de Viagem" />
                        <Label text="Distancia em km:" />
                        <TextField fx:id="txtDistanciaViagem" />
                        <Label text="Preco da gasolina:" />
                        <TextField fx:id="txtPrecoGasolina" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onCalcularViagem" text="Calcular" />
                              <Button mnemonicParsing="false" onAction="#onLimparViagem" text="Limpar" />
                           </children>
                        </HBox>
                        <Label fx:id="lblViagemResultado" text="Resultado..." />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Aluguel de Carro">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Aluguel de Carro" />
                        <Label text="Dias alugados:" />
                        <TextField fx:id="txtDiasAluguel" />
                        <Label text="Km percorridos:" />
                        <TextField fx:id="txtKmPercorrido" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onCalcularAluguel" text="Calcular" />
                              <Button mnemonicParsing="false" onAction="#onLimparAluguel" text="Limpar" />
                           </children>
                        </HBox>
                        <Label fx:id="lblAluguelResultado" text="Resultado..." />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Classes">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Exercicios das Imagens" />
                        <ComboBox fx:id="cbClasseTema" prefWidth="250.0" />
                        <Button mnemonicParsing="false" onAction="#onSimularObjetos" text="Executar" />
                        <TextArea fx:id="txtObjetosInfo" editable="false" prefHeight="250.0" VBox.vgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
